# --- Supabase (Postgres) -----------------------------------------------------
# Supabase dashboard → Connect button → "Transaction pooler" (port 6543).
# Replace [YOUR-PASSWORD] with the DB password you set at project creation.
# Password tip: letters + numbers only (symbols need URL-encoding in this string).
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- Supabase Auth (admin login) ---------------------------------------------
# Supabase dashboard → Project Settings → API.
# The anon/publishable key is safe to expose to the browser.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>

# Optional allowlist: only this Supabase account may enter /onlyme.
ADMIN_EMAIL=you@example.com

# --- Contact form email (SMTP) ---------------------------------------------
# Set these to receive contact form submissions in your inbox.
# For Gmail: use an App Password (not your regular password).
# For Outlook/Hotmail: use your email and password.
# See https://nodemailer.com/smtp/ for details.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com
SMTP_TO=your-email@gmail.com

# --- Contact form spam protection (optional) ---------------------------------
# Cloudflare Turnstile: https://developers.cloudflare.com/turnstile/
# Leave blank to run without the challenge (honeypot + rate limiting still apply).
# The site key is public; the secret key must stay server-side.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
