# --- Supabase (Postgres) -----------------------------------------------------
# Supabase dashboard → Connect button → "Transaction pooler" (port 6543).
# Replace [YOUR-PASSWORD] with the DB password you set at project creation.
# Password tip: letters + numbers only (symbols need URL-encoding in this string).
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- /onlyme admin panel -----------------------------------------------------
# The password YOU type at /onlyme (never treated as a DB credential).
ADMIN_PASSWORD=change-me

# Long random string that signs the admin session cookie.
# Generate: openssl rand -hex 32
SESSION_SECRET=generate-me
